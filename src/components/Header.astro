---
const base = import.meta.env.BASE_URL;
const links = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#skills", label: "Skills" },
  { href: "#works", label: "Works" },
  { href: "#contact", label: "Contact" },
];
---

<header class="relative z-10 mx-auto flex max-w-[1320px] items-center justify-between px-6 py-8 md:px-12">
  <a href="#home" class="shrink-0">
    <img src={`${base}assets/logo.png`} alt="Johan Zuluaga" class="h-16 w-16 md:h-[70px] md:w-[70px] object-contain" />
  </a>

  <nav class="hidden items-center gap-10 lg:flex">
    {links.map((link, i) => (
      <a
        href={link.href}
        class:list={[
          "text-base transition-colors hover:text-teal",
          i === 0 ? "border-b border-teal text-teal" : "text-ink",
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="hidden items-center gap-4 md:flex">
    <a href="#contact" class="text-base text-ink hover:text-teal">Download CV</a>
    <a
      href="#contact"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-ink text-white transition-colors hover:bg-teal"
      aria-label="Download CV"
    >
      <img src={`${base}assets/icon-rocket.png`} alt="" class="h-6 w-6" />
    </a>
  </div>

  <button
    id="nav-toggle"
    class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/20 md:hidden"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>

<nav id="nav-mobile" class="mx-6 mb-4 hidden flex-col gap-4 rounded-2xl border border-ink/10 bg-white p-6 shadow-lg md:hidden">
  {links.map((link) => (
    <a href={link.href} class="text-lg text-ink hover:text-teal">{link.label}</a>
  ))}
  <a href="#contact" class="text-lg font-semibold text-orange">Download CV</a>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
