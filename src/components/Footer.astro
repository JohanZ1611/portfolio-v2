---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const links = [
  { label: "GitHub", href: "https://github.com/JohanZ1611" },
  { label: "LinkedIn", href: "https://linkedin.com/in/johan-zuluaga-870343257" },
  { label: "Figma", href: "https://www.figma.com/files/team/1195005483032463335/recents-and-sharing/recently-viewed?fuid=1195005473945246345" },
];
---

<footer id="contact" class="w-full py-20">
  <div class="mx-auto max-w-[1320px] px-6 md:px-12">
  <div class="grid gap-12 lg:grid-cols-[1fr_auto]">
    <div>
      <h2 class="text-[36px] font-bold leading-tight sm:text-[48px]">
        Let&rsquo;s Make Something<br />Amazing Together.
      </h2>
      <a href="mailto:johan16zulu@gmail.com" class="mt-8 inline-block text-[28px] font-bold sm:text-[36px]">
        Start by <span class="text-orange">saying hi</span>
      </a>
    </div>

    <div>
      <p class="text-xl font-medium">Information</p>
      <ul class="mt-4 flex flex-col gap-3">
        {links.map((l) => (
          <li><a href={l.href} class="text-lg text-ink/80 hover:text-teal">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-16 flex flex-col items-center gap-6 border-t border-ink/10 pt-8 sm:flex-row sm:justify-between">
    <Image src={logo} alt="Johan Zuluaga" width={128} height={128} class="h-16 w-16 object-contain" />
    <p class="text-sm text-ink/70">&copy; 2026. All Rights Reserved</p>
    <p class="text-sm text-ink/70">Desing by <span class="font-bold text-teal">Johan Zuluaga</span></p>
  </div>
  </div>
</footer>
