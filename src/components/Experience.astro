---
const jobs = [
  {
    company: "AssetMinder",
    period: "Oct 2023 - Actuality",
    role: "Back-End",
    dot: "bg-teal",
    description:
      "A visual designer designs for a variety of platforms, which may include Internet and intranet sites, games, movies, kiosks and wearables. In short, they create the concepts,",
  },
  {
    company: "Lance",
    period: "Abr 2023 - Abr 2023",
    role: "FullStack MERN and Mobile",
    dot: "bg-amber",
    description:
      "A visual designer designs for a variety of platforms, which may include Internet and intranet sites, games, movies, kiosks and wearables. In short, they create the concepts,",
  },
  {
    company: "Minga",
    period: "Feb 2023 - Mar 2023",
    role: "FullStack MERN",
    dot: "bg-orange",
    description:
      "A visual designer designs for a variety of platforms, which may include Internet and intranet sites, games, movies, kiosks and wearables. In short, they create the concepts,",
  },
];
---

<section id="skills" class="bg-cream py-20">
  <div class="mx-auto max-w-[1320px] px-6 md:px-12">
    <h2 class="text-center text-[44px] font-bold sm:text-[64px]">My Work Experience</h2>

    <div class="mt-16 flex flex-col">
      {jobs.map((job, i) => (
        <div class="grid grid-cols-[1fr_auto_1fr] items-start gap-6 sm:gap-10">
          <div class="text-right sm:text-right">
            <p class="text-xl font-bold sm:text-2xl">{job.company}</p>
            <p class="mt-2 text-sm text-ink/70 sm:text-base">{job.period}</p>
          </div>

          <div class="flex flex-col items-center">
            <span class:list={["flex h-10 w-10 items-center justify-center rounded-full border border-dashed border-ink/40"]}>
              <span class:list={["h-5 w-5 rounded-full", job.dot]}></span>
            </span>
            {i < jobs.length - 1 && <span class="mt-2 h-24 w-px flex-1 border-l border-dashed border-ink/30 sm:h-32"></span>}
          </div>

          <div class="max-w-[328px]">
            <p class="text-xl font-bold sm:text-2xl">{job.role}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70 sm:text-base">{job.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
