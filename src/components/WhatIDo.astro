---
const base = import.meta.env.BASE_URL;
const services = [
  { icon: "icon-web.png", bg: "bg-teal", title: "Web Design", count: "4 Projects" },
  { icon: "icon-mobile.png", bg: "bg-amber", title: "Mobile App Design", count: "2 Projects" },
  { icon: "icon-pen.png", bg: "bg-orange", title: "Brand Identity", count: "40 Projects" },
];
---

<section id="about" class="mx-auto max-w-[1320px] px-6 py-20 md:px-12">
  <div class="grid gap-16 lg:grid-cols-2 lg:items-center">
    <div class="flex flex-col gap-4">
      {services.map((s) => (
        <div class="flex items-center gap-6 rounded-[20px] border border-[#f0f0f0] bg-white p-6 shadow-[0_10px_40px_rgba(0,0,0,0.06)]">
          <span class:list={["flex h-[85px] w-[85px] shrink-0 items-center justify-center rounded-full", s.bg]}>
            <img src={`${base}assets/${s.icon}`} alt="" class="h-8 w-8 object-contain" />
          </span>
          <div>
            <p class="text-2xl font-bold sm:text-3xl">{s.title}</p>
            <p class="text-lg text-ink/70">{s.count}</p>
          </div>
        </div>
      ))}
    </div>

    <div>
      <h2 class="text-[48px] font-bold leading-none sm:text-[64px]">What do i do?</h2>
      <p class="mt-6 text-lg leading-relaxed text-ink/80" data-content-key="whatido_p1">
        I'm a web developer dedicated to creating digital experiences that are not only clear and accessible, but also engaging and functional for everyone.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink/80" data-content-key="whatido_p2">
        My goal is to simplify the complexity of the digital world, offering websites that anyone can navigate with ease.
      </p>

      <div class="mt-10 flex gap-12">
        <div>
          <p class="text-5xl font-bold" data-content-key="stats_projects_count">5+</p>
          <p class="mt-1 text-lg text-ink/70">Project Completed</p>
        </div>
        <div>
          <p class="text-5xl font-bold" data-content-key="stats_clients_count">3+</p>
          <p class="mt-1 text-lg text-ink/70">Happy Clients</p>
        </div>
      </div>
    </div>
  </div>
</section>
