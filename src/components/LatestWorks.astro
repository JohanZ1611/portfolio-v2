---

<section id="works" class="mx-auto max-w-[1320px] px-6 py-20 md:px-12">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-[44px] font-bold leading-none sm:text-[64px]">My Latest Works</h2>
      <p class="mt-3 text-lg text-ink/70">Perfect solution for digital experience</p>
    </div>
    <a href="#works" class="text-lg font-bold text-orange hover:underline">Explore More Works</a>
  </div>

  <div id="works-grid" class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
    <p class="col-span-full text-ink/50">Loading projects…</p>
  </div>
</section>

<script>
  import { supabase, projectImageUrl, type Project } from "../lib/supabase";

  const grid = document.getElementById("works-grid")!;

  function render(projects: Project[]) {
    if (projects.length === 0) {
      grid.innerHTML = `<p class="col-span-full text-ink/50">No projects published yet.</p>`;
      return;
    }
    grid.innerHTML = projects
      .map((p) => {
        const img = projectImageUrl(p.image_path) ?? "";
        const linkOpen = p.url ? `<a href="${p.url}" target="_blank" rel="noopener">` : "<div>";
        const linkClose = p.url ? "</a>" : "</div>";
        return `
          ${linkOpen}
            <article class="group relative aspect-square overflow-hidden rounded-[40px] shadow-[0_14px_60px_rgba(0,0,0,0.15)]">
              ${img ? `<img src="${img}" alt="${p.title}" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />` : `<div class="h-full w-full bg-cream"></div>`}
              <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
              <div class="absolute left-6 top-6 text-white">
                <p class="text-2xl font-bold">${p.title}</p>
                ${p.description ? `<p class="mt-1 text-sm text-white/90">${p.description}</p>` : ""}
              </div>
            </article>
          ${linkClose}
        `;
      })
      .join("");
  }

  supabase
    .from("projects")
    .select("*")
    .eq("visible", true)
    .order("sort_order", { ascending: true })
    .then(({ data, error }) => {
      if (error) {
        grid.innerHTML = `<p class="col-span-full text-ink/50">Could not load projects.</p>`;
        return;
      }
      render((data ?? []) as Project[]);
    });
</script>
