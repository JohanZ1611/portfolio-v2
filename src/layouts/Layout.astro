---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Johan Zuluaga — FullStack Developer",
  description = "I weave code with art and functionality, transforming ideas into captivating digital experiences.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-white">
    <slot />
    <script>
      import { hydrateContent } from "../lib/content";
      hydrateContent();
    </script>
  </body>
</html>
